{
  // Veleggia Capital rules app. Secrets (FMP key, VAPID key, later Bybit read-only key) are set with
  // `wrangler secret put NAME` or in the Cloudflare dashboard, never in this file or the repo.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "veleggia-capital",
  // Marc's Cloudflare account (the id is not a secret).
  "account_id": "c4ad492baa9588736c3521811736ae6f",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The app is reached on its workers.dev address, protected by Cloudflare Access (login) and checked again in the Worker.
  "workers_dev": true,
  "observability": { "enabled": true },
  // Rule checks: every hour at :05 (crypto daily close 00:05 UTC, each 4H close, ES futures close 21:05/22:05 UTC),
  // plus 16:20 New York on weekdays for the cash index close (20:20 UTC in summer, 21:20 UTC in winter).
  "triggers": { "crons": ["5 * * * *", "20 20,21 * * 1-5"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veleggia",
      // D1 database "veleggia" in Marc's Cloudflare account (the id is not a secret).
      "database_id": "4ee4fa3d-0b2a-4605-9eed-628833287851",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access (login). Not secret; filled in after Access is set up.
    // ALLOWED_EMAILS: second check after Access, comma-separated (only Marc).
    "ACCESS_TEAM_DOMAIN": "keiser-marc.cloudflareaccess.com",
    "ACCESS_AUD": "81b3b2f70465470b8d6821393e4dfdb01a5074e925305c94d28ff41edf4cdd07",
    "ALLOWED_EMAILS": "keiser_marc@me.com"
  }
}
