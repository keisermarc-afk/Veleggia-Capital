{
  // Veleggia Capital rules app. Secrets (FMP key, VAPID key, later Bybit read-only key) are set with
  // `wrangler secret put NAME` or in the Cloudflare dashboard, never in this file or the repo.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "veleggia-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veleggia",
      // D1 database "veleggia" in Marc's Cloudflare account (the id is not a secret).
      "database_id": "4ee4fa3d-0b2a-4605-9eed-628833287851",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access (login). Not secret; filled in after Access is set up.
    // ALLOWED_EMAILS: optional second check after Access, comma-separated; set it in the Cloudflare dashboard.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": ""
  }
}
